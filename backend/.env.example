# === API Keys ===
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
HF_TOKEN=your_huggingface_token

COURSERA_API_KEY=your_coursera_api_key
COURSERA_SECRET_KEY=your_coursera_secret

YOUTUBE_API_KEY=your_youtube_api_key
TAVILY_API_KEY=your_tavily_api_key

# === Database ===
DATABASE_URI=postgresql+psycopg2://username:password@host:port/db_name
DB_CONTAINER=your_db_container
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=your_db_port

# === JWT / Auth ===
JWT_SECRET_KEY=your_jwt_secret
JWT_SECRET_KEY_REFRESH=your_jwt_refresh_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# === Email / OTP ===
RESEND_API_KEY=your_resend_api_key
SENDER_MAIL=your_sender_email
EXPIRY_SECONDS=300
COOLDOWN_SECONDS=60
OTP_LIMIT=2

